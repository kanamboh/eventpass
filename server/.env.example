# EventPass Server Environment Configuration Template
# Copy this to .env and provide your local credentials

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Database Connection (PostgreSQL)
# DATABASE_URL: Pooled connection string (e.g., PgBouncer / Neon pooler on port 6543)
DATABASE_URL="postgresql://user:password@localhost:5432/eventpass_dev?schema=public"
# DIRECT_URL: Direct unpooled connection string for migrations (port 5432)
DIRECT_URL="postgresql://user:password@localhost:5432/eventpass_dev?schema=public"

# Allowed Frontend Client URL for CORS
CLIENT_URL="http://localhost:5173"

# Session Secret (random 64-char string in production)
SESSION_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars-long"

# Log Level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL="info"

# Payment Processing Feature Flag (Set strictly to 'true' to enable; default/unset is false)
PAYMENTS_ENABLED=false

# Public Registration Feature Flag (Set to 'false' to disable public signups and make instance private)
REGISTRATION_ENABLED=true

# Payment Provider Configuration: 'MOCK' or 'PAYSTACK'
PAYMENT_PROVIDER="MOCK"

# Paystack Test / Live Credentials
PAYSTACK_SECRET_KEY="sk_test_your_secret_key_here"
PAYSTACK_PUBLIC_KEY="pk_test_your_public_key_here"
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret_here"

# Paystack Domiciled Merchant Country: 'KE' (Kenya) or 'ZA' (South Africa)
# Note: Kenyan accounts ('KE') support KES and USD. South African accounts ('ZA') support ZAR.
PAYSTACK_MERCHANT_COUNTRY="KE"

# =========================================================================
# Transactional Email Provider Configuration
# =========================================================================
# EMAIL_PROVIDER="MOCK" for local development and automated CI tests.
# Mock mode safely renders authentic HTML & plain-text emails in-memory without sending network emails.
#
# To deliver real emails to actual user inboxes, configure EMAIL_PROVIDER="SMTP":
# EMAIL_PROVIDER="SMTP"
# SMTP_HOST="smtp.sendgrid.net" # e.g. smtp.mailgun.org / email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false # Set to true for port 465 (SSL/TLS), false for 587 (STARTTLS)
# SMTP_USER="apikey"
# SMTP_PASS="your_smtp_api_key_or_password_here"
# EMAIL_FROM="EventPass <tickets@eventpass.co.za>"
# SUPPORT_EMAIL="support@eventpass.co.za"

EMAIL_PROVIDER="MOCK"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password_here"
EMAIL_FROM="tickets@eventpass.co.za"
SUPPORT_EMAIL="support@eventpass.co.za"

# =========================================================================
# Persistent Cloud Image Storage Configuration (Cloudinary Free Tier)
# =========================================================================
# STORAGE_PROVIDER="MOCK" generates deterministic persistent URLs without external credentials (ideal for tests & local development).
#
# To store event posters on Cloudinary's permanent free tier:
# STORAGE_PROVIDER="CLOUDINARY"
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_cloudinary_api_key"
# CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
STORAGE_PROVIDER="MOCK"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
